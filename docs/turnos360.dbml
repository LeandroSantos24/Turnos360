// Turnos360 — esquema de la base
//
// GENERADO AUTOMÁTICAMENTE. No lo edites a mano: se regenera con
//     make dbml     (o: python -m app.tools.generar_dbml)
// y hay un test que falla si queda desactualizado.
//
// Para verlo: https://dbdiagram.io  ->  Import  ->  pegar este archivo.

Project turnos360 {
  database_type: 'PostgreSQL'
  Note: 'Gestión de turnos multiempresa. Toda tabla de negocio lleva empresa_id (Regla 1).'
}


// ── Enums ──────────────────────────────────────────────────
Enum canal_mensaje {
  "whatsapp"
  "email"
}

Enum direccion_mensaje {
  "saliente"
  "entrante"
}

Enum estado_caja {
  "abierta"
  "cerrada"
}

Enum estado_gift_card {
  "activa"
  "canjeada"
  "vencida"
  "anulada"
}

Enum estado_membresia {
  "ACTIVA"
  "SUSPENDIDA"
  "VENCIDA"
  "PENDIENTE_PAGO"
}

Enum estado_mensaje {
  "pendiente"
  "enviado"
  "entregado"
  "leido"
  "fallido"
}

Enum estado_turno {
  "pendiente"
  "confirmado"
  "en_curso"
  "finalizado"
  "cancelado"
  "ausente"
}

Enum modalidad_comision {
  "porcentaje"
  "canon_consulta"
  "alquiler"
}

Enum rol_usuario {
  "dueno"
  "admin"
  "recepcion"
  "profesional"
}

Enum tipo_excepcion {
  "feriado"
  "licencia"
  "vacaciones"
  "bloqueo"
}

Enum tipo_movimiento {
  "ingreso"
  "egreso"
}

Enum tipo_recurso {
  "persona"
  "box"
  "equipo"
}

Enum tipo_turno {
  "simple"
  "recurrente"
  "serie"
  "orden_llegada"
  "orden_trabajo"
}


// ── Tablas ─────────────────────────────────────────────────

Table adjunto {
  id integer [pk]
  cliente_id integer [ref: > cliente.id, not null]
  entrada_clinica_id integer
  tipo varchar(40)
  nombre_archivo varchar(255) [not null]
  ruta varchar(500) [not null]
  subido_por integer [ref: > usuario.id]
  fecha timestamp with time zone [not null]
  empresa_id integer [ref: > empresa.id, not null]

  Indexes {
    empresa_id [name: 'ix_adjunto_empresa_id']
  }
}

Table ajuste_suscripcion {
  id integer [pk]
  empresa_id integer [ref: > empresa.id, not null]
  tipo varchar(20) [not null]
  vence_antes date
  vence_despues date
  dias integer
  detalle text
  pago_id integer [ref: > pago_suscripcion.id]
  hecho_por varchar(160)
  creado_en timestamp with time zone [not null]
  revertido boolean [not null]
  revertido_en timestamp with time zone
  revertido_por varchar(160)

  Indexes {
    (empresa_id, creado_en) [name: 'ix_ajuste_suscripcion_empresa']
    empresa_id [name: 'ix_ajuste_suscripcion_empresa_id']
  }
}

Table aviso_pago {
  id integer [pk]
  empresa_id integer [ref: > empresa.id, not null]
  metodo varchar(40) [not null]
  monto numeric(12, 2)
  referencia text
  avisado_por varchar(160)
  creado_en timestamp with time zone [not null]
  resuelto boolean [not null]
  resuelto_en timestamp with time zone
  resuelto_por varchar(160)
  pago_id integer [ref: > pago_suscripcion.id]

  Indexes {
    empresa_id [name: 'ix_aviso_pago_empresa_id']
    creado_en [name: 'ix_aviso_pago_pendiente']
  }
}

Table caja {
  id integer [pk]
  sucursal_id integer [ref: > sucursal.id]
  fecha_apertura timestamp with time zone [not null]
  fecha_cierre timestamp with time zone
  saldo_inicial numeric(12, 2) [not null]
  saldo_final numeric(12, 2)
  estado estado_caja [not null]
  abierta_por integer [ref: > usuario.id]
  cerrada_por integer [ref: > usuario.id]
  empresa_id integer [ref: > empresa.id, not null]

  Indexes {
    empresa_id [name: 'ix_caja_empresa_id']
  }
}

Table calificacion {
  id integer [pk]
  turno_id integer [ref: > turno.id, not null]
  cliente_id integer [ref: > cliente.id, not null]
  puntaje integer [not null]
  comentario text
  fecha timestamp with time zone [not null]
  empresa_id integer [ref: > empresa.id, not null]

  Indexes {
    empresa_id [name: 'ix_calificacion_empresa_id']
  }
}

Table categoria_financiera {
  id integer [pk]
  nombre varchar(80) [not null]
  tipo tipo_movimiento [not null]
  empresa_id integer [ref: > empresa.id, not null]

  Indexes {
    empresa_id [name: 'ix_categoria_financiera_empresa_id']
  }
}

Table cliente {
  id integer [pk]
  nombre varchar(120) [not null]
  apellido varchar(120)
  dni varchar(20)
  email varchar(200)
  telefono varchar(40)
  fecha_nacimiento date
  canal_adquisicion varchar(60)
  ultimo_cumple_enviado date
  acepta_marketing boolean [not null]
  acepta_whatsapp boolean [not null]
  ultimo_inactivo_enviado date
  campos_rubro jsonb [not null]
  preferencias jsonb [not null]
  etiquetas jsonb
  observaciones text
  activo boolean [not null]
  creado_en timestamp with time zone [not null]
  empresa_id integer [ref: > empresa.id, not null]

  Indexes {
    (empresa_id, apellido, nombre) [name: 'ix_cliente_empresa_apellido_nombre']
    (empresa_id, dni) [name: 'ix_cliente_empresa_dni']
    empresa_id [name: 'ix_cliente_empresa_id']
    (empresa_id, telefono) [name: 'ix_cliente_empresa_telefono']
  }
}

Table comision_profesional {
  id integer [pk]
  recurso_id integer [ref: > recurso.id, not null]
  modalidad modalidad_comision [not null]
  porcentaje numeric(5, 2)
  monto numeric(12, 2)
  vigencia_desde date
  empresa_id integer [ref: > empresa.id, not null]

  Indexes {
    empresa_id [name: 'ix_comision_profesional_empresa_id']
  }
}

Table cupon_descuento {
  id integer [pk]
  codigo varchar(30) [not null]
  tipo varchar(10) [not null]
  valor numeric(12, 2) [not null]
  vence_el date
  max_usos integer
  usos integer [not null]
  servicios_ids jsonb [not null]
  activo boolean [not null]
  empresa_id integer [ref: > empresa.id, not null]

  Indexes {
    empresa_id [name: 'ix_cupon_descuento_empresa_id']
  }
}

Table deuda_cliente {
  id integer [pk]
  cliente_id integer [ref: > cliente.id, not null]
  monto numeric(12, 2) [not null]
  saldada boolean [not null]
  ref_tabla varchar(40)
  ref_id integer
  fecha timestamp with time zone [not null]
  empresa_id integer [ref: > empresa.id, not null]

  Indexes {
    empresa_id [name: 'ix_deuda_cliente_empresa_id']
  }
}

Table empresa {
  id integer [pk]
  rubro_id integer [ref: > rubro.id, not null]
  nombre varchar(120) [not null]
  slug varchar(80) [not null, unique]
  config_pack jsonb [not null]
  descripcion text
  direccion varchar(200)
  telefono_publico varchar(40)
  email_publico varchar(120)
  logo_url varchar(300)
  portada_url varchar(300)
  color_marca varchar(7)
  reserva_anticipacion_min integer [not null]
  reserva_dias_max integer [not null]
  reserva_fecha_limite date
  reserva_permite_cancelar boolean [not null]
  reserva_pide_telefono boolean [not null]
  reserva_pide_nacimiento boolean [not null]
  meta_pixel_id varchar(40)
  google_tag_id varchar(40)
  google_conversion_label varchar(60)
  horarios_atencion jsonb
  redes jsonb
  galeria jsonb
  wa_credenciales bytea
  wa_phone_number_id varchar(40)
  email_credenciales bytea
  automatizaciones jsonb
  mp_credenciales bytea
  sena_activa boolean [not null]
  cobro_modo varchar(10) [not null]
  sena_monto numeric(12, 2)
  activa boolean [not null]
  plan varchar(20) [not null]
  suscripcion_vence date
  prueba_hasta date
  razon_social varchar(160)
  cuit varchar(20)
  contacto_nombre varchar(120)
  contacto_email varchar(160)
  contacto_telefono varchar(40)
  notas_admin text
  precio_mensual numeric(12, 2)
  limite_recursos integer
  limite_sucursales integer
  de_registro_publico boolean [not null]
  creada_en timestamp with time zone [not null]

  Indexes {
    wa_phone_number_id [name: 'ix_empresa_wa_phone_number_id']
  }
}

Table entrada_clinica {
  id integer [pk]
  cliente_id integer [ref: > cliente.id, not null]
  turno_id integer [ref: > turno.id]
  fecha date [not null]
  tipo varchar(40) [not null]
  como_se_sintio text
  noto_diferencia text
  apetito text
  entrenamiento text
  descanso text
  estres text
  resumen_antropometria text
  prescripcion text
  proximo_turno date
  creada_en timestamp with time zone [not null]
  empresa_id integer [ref: > empresa.id, not null]

  Indexes {
    empresa_id [name: 'ix_entrada_clinica_empresa_id']
    (empresa_id, cliente_id, fecha) [name: 'ix_entrada_empresa_cliente_fecha']
  }
}

Table especialidad {
  id integer [pk]
  nombre varchar(120) [not null]
  empresa_id integer [ref: > empresa.id, not null]

  Indexes {
    empresa_id [name: 'ix_especialidad_empresa_id']
  }
}

Table excepcion_agenda {
  id integer [pk]
  recurso_id integer [ref: > recurso.id]
  tipo tipo_excepcion [not null]
  fecha_desde date [not null]
  fecha_hasta date [not null]
  motivo varchar(200)
  empresa_id integer [ref: > empresa.id, not null]

  Indexes {
    empresa_id [name: 'ix_excepcion_agenda_empresa_id']
  }
}

Table ficha_clinica {
  id integer [pk]
  cliente_id integer [ref: > cliente.id, not null]
  motivo_consulta text
  objetivo text
  ocupacion varchar(200)
  horario_trabajo varchar(200)
  fum date
  horario_comidas jsonb [not null]
  recordatorio_24h jsonb [not null]
  frecuencia_consumo jsonb [not null]
  actividad_fisica text
  enfermedades text
  operaciones text
  medicacion text
  antecedentes_familiares text
  consume_alcohol_drogas varchar(200)
  fuma varchar(120)
  sintomas_recurrentes text
  evacuacion varchar(200)
  sueno varchar(200)
  alimentos_no_consume text
  alimentos_no_tolera text
  alimentos_gustan text
  nutri_anterior text
  obra_social varchar(120)
  plan_obra_social varchar(120)
  nro_afiliado varchar(60)
  datos_extra jsonb [not null]
  creada_en timestamp with time zone [not null]
  actualizada_en timestamp with time zone [not null]
  empresa_id integer [ref: > empresa.id, not null]

  Indexes {
    empresa_id [name: 'ix_ficha_clinica_empresa_id']
    (empresa_id, cliente_id) [name: 'ix_ficha_empresa_cliente']
  }
}

Table gift_card {
  id integer [pk]
  codigo varchar(40) [not null]
  beneficiario varchar(120)
  de_parte_de varchar(120)
  mensaje varchar(300)
  monto numeric(12, 2) [not null]
  concepto varchar(120)
  estado estado_gift_card [not null]
  vence date
  metodo_pago_id integer [ref: > metodo_pago.id]
  movimiento_id integer [ref: > movimiento_financiero.id]
  canjeada_en timestamp with time zone
  canjeada_por varchar(120)
  creada_en timestamp with time zone [not null]
  empresa_id integer [ref: > empresa.id, not null]

  Indexes {
    (empresa_id, codigo) [name: 'ix_gift_card_empresa_codigo', unique]
    (empresa_id, estado) [name: 'ix_gift_card_empresa_estado']
    empresa_id [name: 'ix_gift_card_empresa_id']
  }
}

Table historial_cliente {
  id integer [pk]
  cliente_id integer [ref: > cliente.id, not null]
  tipo_evento varchar(40) [not null]
  descripcion varchar(300)
  ref_tabla varchar(40)
  ref_id integer
  fecha timestamp with time zone [not null]
  empresa_id integer [ref: > empresa.id, not null]

  Indexes {
    empresa_id [name: 'ix_historial_cliente_empresa_id']
    (empresa_id, cliente_id, fecha) [name: 'ix_historial_empresa_cliente_fecha']
  }
}

Table horario_recurso {
  id integer [pk]
  recurso_id integer [ref: > recurso.id, not null]
  dia_semana integer [not null]
  hora_desde time without time zone [not null]
  hora_hasta time without time zone [not null]
  vigencia_desde date
  vigencia_hasta date
  empresa_id integer [ref: > empresa.id, not null]

  Indexes {
    (empresa_id, recurso_id, dia_semana) [name: 'ix_horario_empresa_recurso_dia']
    empresa_id [name: 'ix_horario_recurso_empresa_id']
  }
}

Table item_turno {
  id integer [pk]
  turno_id integer [ref: > turno.id, not null]
  descripcion varchar(160) [not null]
  precio numeric(12, 2) [not null]
  cantidad integer [not null]
  tipo varchar(40) [not null]
  creado_en timestamp with time zone [not null]
  empresa_id integer [ref: > empresa.id, not null]

  Indexes {
    empresa_id [name: 'ix_item_turno_empresa_id']
    (empresa_id, turno_id) [name: 'ix_item_turno_empresa_turno']
    turno_id [name: 'ix_item_turno_turno']
  }
}

Table lista_espera {
  id integer [pk]
  cliente_id integer [ref: > cliente.id, not null]
  servicio_id integer [ref: > servicio.id]
  recurso_id integer [ref: > recurso.id]
  rango_preferido varchar(120)
  estado varchar(20) [not null]
  creado_en timestamp with time zone [not null]
  empresa_id integer [ref: > empresa.id, not null]

  Indexes {
    empresa_id [name: 'ix_lista_espera_empresa_id']
  }
}

Table log_auditoria {
  id bigint [pk]
  empresa_id integer [ref: > empresa.id]
  usuario_id integer [ref: > usuario.id]
  accion varchar(30) [not null]
  tabla varchar(60)
  registro_id integer
  detalle jsonb
  ip varchar(45)
  fecha timestamp with time zone [not null]

  Indexes {
    empresa_id [name: 'ix_log_auditoria_empresa_id']
    (empresa_id, fecha) [name: 'ix_log_empresa_fecha']
    (tabla, registro_id) [name: 'ix_log_tabla_registro']
  }
}

Table medicion_antropometrica {
  id integer [pk]
  cliente_id integer [ref: > cliente.id, not null]
  entrada_id integer [ref: > entrada_clinica.id]
  fecha date [not null]
  evaluador varchar(120)
  origen varchar(40) [not null]
  peso_kg numeric(6, 2)
  talla_cm numeric(6, 2)
  imc numeric(5, 2)
  talla_sentado_cm numeric(6, 2)
  envergadura_cm numeric(6, 2)
  pl_triceps numeric(5, 1)
  pl_subescapular numeric(5, 1)
  pl_biceps numeric(5, 1)
  pl_cresta_iliaca numeric(5, 1)
  pl_supraespinal numeric(5, 1)
  pl_abdominal numeric(5, 1)
  pl_muslo numeric(5, 1)
  pl_pierna numeric(5, 1)
  sumatoria_pliegues numeric(6, 1)
  per_cintura numeric(6, 2)
  per_cadera numeric(6, 2)
  per_brazo numeric(6, 2)
  per_muslo numeric(6, 2)
  per_pierna numeric(6, 2)
  masa_grasa_kg numeric(6, 2)
  masa_grasa_pct numeric(5, 2)
  masa_muscular_kg numeric(6, 2)
  masa_osea_kg numeric(6, 2)
  datos_isak jsonb [not null]
  creada_en timestamp with time zone [not null]
  empresa_id integer [ref: > empresa.id, not null]

  Indexes {
    empresa_id [name: 'ix_medicion_antropometrica_empresa_id']
    (empresa_id, cliente_id, fecha) [name: 'ix_medicion_empresa_cliente_fecha']
  }
}

Table membresia {
  id integer [pk]
  cliente_id integer [ref: > cliente.id, not null]
  plan_id integer [ref: > plan_abono.id, not null]
  fecha_desde date [not null]
  fecha_hasta date [not null]
  estado estado_membresia [not null]
  cupos_usados integer [not null]
  metodo_pago_id integer [ref: > metodo_pago.id]
  movimiento_id integer [ref: > movimiento_financiero.id]
  monto_cobrado numeric(12, 2)
  creado_en timestamp with time zone [not null]
  empresa_id integer [ref: > empresa.id, not null]

  Indexes {
    (empresa_id, cliente_id) [name: 'ix_membresia_empresa_cliente']
    empresa_id [name: 'ix_membresia_empresa_id']
    (empresa_id, fecha_hasta) [name: 'ix_membresia_vigencia']
  }
}

Table mensaje {
  id bigint [pk]
  cliente_id integer [ref: > cliente.id]
  turno_id integer [ref: > turno.id]
  canal canal_mensaje [not null]
  direccion direccion_mensaje [not null]
  plantilla_id integer [ref: > plantilla_mensaje.id]
  contenido text
  estado estado_mensaje [not null]
  error varchar(300)
  externo_id varchar(80)
  fecha timestamp with time zone [not null]
  empresa_id integer [ref: > empresa.id, not null]

  Indexes {
    (empresa_id, cliente_id) [name: 'ix_mensaje_empresa_cliente']
    (empresa_id, fecha) [name: 'ix_mensaje_empresa_fecha']
    empresa_id [name: 'ix_mensaje_empresa_id']
    (empresa_id, turno_id) [name: 'ix_mensaje_empresa_turno']
    externo_id [name: 'ix_mensaje_externo_id']
  }
}

Table metodo_pago {
  id integer [pk]
  nombre varchar(60) [not null]
  comision_pct numeric(5, 2) [not null]
  activo boolean [not null]
  empresa_id integer [ref: > empresa.id, not null]

  Indexes {
    empresa_id [name: 'ix_metodo_pago_empresa_id']
  }
}

Table movimiento_financiero {
  id integer [pk]
  caja_id integer [ref: > caja.id]
  fecha timestamp with time zone [not null]
  tipo tipo_movimiento [not null]
  concepto varchar(120)
  descripcion varchar(300)
  monto numeric(12, 2) [not null]
  moneda varchar(3) [not null]
  metodo_pago_id integer [ref: > metodo_pago.id]
  categoria_id integer [ref: > categoria_financiera.id]
  usuario_id integer [ref: > usuario.id]
  anulado boolean [not null]
  anulado_en timestamp with time zone
  anulado_por_id integer [ref: > usuario.id]
  motivo_anulacion varchar(200)
  empresa_id integer [ref: > empresa.id, not null]

  Indexes {
    (empresa_id, caja_id, anulado) [name: 'ix_movfin_caja_activos']
    (empresa_id, fecha) [name: 'ix_movfin_empresa_fecha']
    (empresa_id, tipo, categoria_id) [name: 'ix_movfin_empresa_tipo_categoria']
    empresa_id [name: 'ix_movimiento_financiero_empresa_id']
  }
}

Table pago {
  id integer [pk]
  turno_id integer [ref: > turno.id]
  orden_trabajo_id integer
  cliente_id integer [ref: > cliente.id]
  metodo_pago_id integer [ref: > metodo_pago.id]
  origen varchar(20)
  monto numeric(12, 2) [not null]
  comision_aplicada numeric(12, 2)
  movimiento_id integer [ref: > movimiento_financiero.id]
  fecha timestamp with time zone [not null]
  anulado boolean [not null]
  anulado_en timestamp with time zone
  anulado_por_id integer
  motivo_anulacion varchar(200)
  empresa_id integer [ref: > empresa.id, not null]

  Indexes {
    (empresa_id, cliente_id) [name: 'ix_pago_empresa_cliente']
    (empresa_id, fecha) [name: 'ix_pago_empresa_fecha']
    empresa_id [name: 'ix_pago_empresa_id']
    (empresa_id, origen) [name: 'ix_pago_empresa_origen']
    (empresa_id, fecha) [name: 'ix_pago_empresa_vigente']
    movimiento_id [name: 'ix_pago_movimiento']
    turno_id [name: 'ix_pago_turno']
    turno_id [name: 'uq_pago_sena_turno', unique]
  }
}

Table pago_suscripcion {
  id integer [pk]
  empresa_id integer [ref: > empresa.id, not null]
  fecha date [not null]
  monto numeric(12, 2) [not null]
  metodo varchar(40) [not null]
  periodo_desde date
  periodo_hasta date
  notas text
  registrado_por varchar(160)
  creado_en timestamp with time zone [not null]
  mp_payment_id varchar(40)
  anulado boolean [not null]
  anulado_en timestamp with time zone
  anulado_por varchar(160)

  Indexes {
    (empresa_id, fecha) [name: 'ix_pago_suscripcion_empresa_fecha']
    empresa_id [name: 'ix_pago_suscripcion_empresa_id']
    fecha [name: 'ix_pago_suscripcion_fecha']
    mp_payment_id [name: 'uq_pago_suscripcion_mp', unique]
  }
}

Table plan_abono {
  id integer [pk]
  nombre varchar(80) [not null]
  descripcion varchar(300)
  precio numeric(12, 2) [not null]
  ilimitado boolean [not null]
  cantidad_cupos integer
  servicios_cubiertos jsonb
  activo boolean [not null]
  creado_en timestamp with time zone [not null]
  empresa_id integer [ref: > empresa.id, not null]

  Indexes {
    (empresa_id, activo) [name: 'ix_plan_abono_empresa_activo']
    empresa_id [name: 'ix_plan_abono_empresa_id']
  }
}

Table plantilla_mensaje {
  id integer [pk]
  canal canal_mensaje [not null]
  codigo varchar(60) [not null]
  nombre varchar(120) [not null]
  cuerpo text [not null]
  aprobada_meta boolean [not null]
  con_botones boolean [not null]
  activa boolean [not null]
  empresa_id integer [ref: > empresa.id, not null]

  Indexes {
    empresa_id [name: 'ix_plantilla_mensaje_empresa_id']
  }
}

Table recurso {
  id integer [pk]
  sucursal_id integer [ref: > sucursal.id]
  tipo tipo_recurso [not null]
  nombre varchar(120) [not null]
  usuario_id integer [ref: > usuario.id]
  color varchar(9)
  foto_url varchar(300)
  activo boolean [not null]
  empresa_id integer [ref: > empresa.id, not null]

  Indexes {
    empresa_id [name: 'ix_recurso_empresa_id']
    (empresa_id, tipo) [name: 'ix_recurso_empresa_tipo']
  }
}

Table recurso_especialidad {
  recurso_id integer [pk, ref: > recurso.id]
  especialidad_id integer [pk, ref: > especialidad.id]
}

Table rubro {
  id integer [pk]
  codigo varchar(40) [not null, unique]
  nombre varchar(120) [not null]
  preset jsonb [not null]
  activo boolean [not null]
}

Table servicio {
  id integer [pk]
  nombre varchar(120) [not null]
  duracion_min integer [not null]
  buffer_min integer [not null]
  paso_turno_min integer [not null]
  grupo_agenda varchar(40)
  precio numeric(12, 2)
  activo boolean [not null]
  agendable boolean [not null]
  empresa_id integer [ref: > empresa.id, not null]

  Indexes {
    (empresa_id, activo) [name: 'ix_servicio_empresa_activo']
    empresa_id [name: 'ix_servicio_empresa_id']
  }
}

Table servicio_recurso {
  servicio_id integer [pk, ref: > servicio.id]
  recurso_id integer [pk, ref: > recurso.id]
}

Table sucursal {
  id integer [pk]
  nombre varchar(120) [not null]
  direccion varchar(200)
  activa boolean [not null]
  empresa_id integer [ref: > empresa.id, not null]

  Indexes {
    empresa_id [name: 'ix_sucursal_empresa_id']
  }
}

Table super_admin {
  id integer [pk]
  nombre varchar(120) [not null]
  email varchar(200) [not null, unique]
  hash_clave varchar(300) [not null]
  activo boolean [not null]
}

Table turno {
  id integer [pk]
  sucursal_id integer [ref: > sucursal.id]
  cliente_id integer [ref: > cliente.id, not null]
  recurso_id integer [ref: > recurso.id, not null]
  servicio_id integer [ref: > servicio.id]
  vehiculo_id integer
  paquete_id integer
  tipo tipo_turno [not null]
  estado estado_turno [not null]
  categoria varchar(60)
  fecha_inicio timestamp with time zone
  fecha_fin timestamp with time zone
  posicion_cola integer
  serie_grupo_id integer
  es_sobreturno boolean [not null]
  importe_previsto numeric(12, 2)
  cubierto_por_abono boolean [not null]
  descuento_pct numeric(5, 2) [not null]
  cupon_id integer [ref: > cupon_descuento.id]
  cobrado boolean [not null]
  sena_estado varchar(20)
  sena_monto numeric(12, 2)
  mp_payment_id varchar(60)
  recordatorio_enviado boolean [not null]
  recordatorio_2h_enviado boolean [not null]
  creado_at timestamp with time zone [not null]
  motivo_cancelacion varchar(300)
  notas text
  creado_por integer [ref: > usuario.id]
  creado_en timestamp with time zone [not null]
  empresa_id integer [ref: > empresa.id, not null]

  Indexes {
    (empresa_id, cliente_id) [name: 'ix_turno_empresa_cliente']
    (empresa_id, cupon_id) [name: 'ix_turno_empresa_cupon']
    (empresa_id, estado, fecha_inicio) [name: 'ix_turno_empresa_estado_inicio']
    empresa_id [name: 'ix_turno_empresa_id']
    (empresa_id, recurso_id, fecha_inicio) [name: 'ix_turno_empresa_recurso_inicio']
    fecha_inicio [name: 'ix_turno_recordatorio_2h_pendiente']
    fecha_inicio [name: 'ix_turno_recordatorio_pendiente']
    creado_at [name: 'ix_turno_sena_pendiente']
  }
}

Table usuario {
  id integer [pk]
  sucursal_id integer [ref: > sucursal.id]
  nombre varchar(120) [not null]
  email varchar(200) [not null]
  hash_clave varchar(300) [not null]
  rol rol_usuario [not null]
  activo boolean [not null]
  email_verificado boolean [not null]
  verif_token_hash varchar(128)
  verif_token_expira timestamp with time zone
  reset_token_hash varchar(128)
  reset_token_expira timestamp with time zone
  token_version integer [not null]
  empresa_id integer [ref: > empresa.id, not null]

  Indexes {
    empresa_id [name: 'ix_usuario_empresa_id']
  }
}

Table wa_movimiento {
  id bigint [pk]
  cantidad integer [not null]
  motivo varchar(20) [not null]
  detalle varchar(200)
  precio_ars numeric(12, 2)
  mensaje_id bigint [ref: > mensaje.id]
  usuario_id integer [ref: > usuario.id]
  fecha timestamp with time zone [not null]
  empresa_id integer [ref: > empresa.id, not null]

  Indexes {
    (empresa_id, fecha) [name: 'ix_wa_movimiento_empresa_fecha']
    empresa_id [name: 'ix_wa_movimiento_empresa_id']
  }
}

Table wa_saldo {
  empresa_id integer [pk, ref: > empresa.id]
  disponible integer [not null]
  consumidos integer [not null]
  actualizado timestamp with time zone [not null]
}

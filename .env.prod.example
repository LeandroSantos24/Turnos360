# Plantilla del .env.prod. Copiar al servidor como .env.prod y completar.
# No se versiona (.gitignore excluye .env*).
#
# NO PONGAS COMENTARIOS EN LA MISMA LINEA QUE UNA VARIABLE. Si la variable
# queda vacia, Docker Compose toma el comentario COMO VALOR.
#
# Generar secretos:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"

# ── Base de datos y Redis ──────────────────────────────────────────────────
POSTGRES_USER=turnos360
POSTGRES_PASSWORD=
POSTGRES_DB=turnos360
# Solo alfanumerico: viaja dentro de una URL.
REDIS_PASSWORD=

# ── Secretos ───────────────────────────────────────────────────────────────
# Distintas entre si. Rotar FERNET_KEY deja ilegible lo ya guardado.
SECRET_KEY=
FERNET_KEY=

# ── Super-admin (primer seed) ──────────────────────────────────────────────
# NO uses admin@turnos360.com / superadmin360: estan en el repo publico.
# Minimo 16 caracteres. Se rota con: python -m app.seeds_minimo --rotar-clave
SUPERADMIN_EMAIL=
SUPERADMIN_PASS=

# ── URLs ───────────────────────────────────────────────────────────────────
# NEXT_PUBLIC_API_URL se hornea en el bundle: si cambia, rebuildear el front.
NEXT_PUBLIC_API_URL=
PUBLIC_BASE_URL=
API_BASE_URL=
# Separados por coma.
CORS_ORIGINS=

# ── Entorno ────────────────────────────────────────────────────────────────
ENV=prod
ZONA_HORARIA=America/Argentina/Buenos_Aires
UVICORN_WORKERS=2
LOG_JSON=true
SENTRY_DSN=

# ── Email saliente ─────────────────────────────────────────────────────────
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ── Mercado Pago: firma de los webhooks de señas ───────────────────────────
# off | log | enforce. Camino: log unos dias, mirar los logs, enforce.
MP_FIRMA_MODO=off
MP_WEBHOOK_SECRET=

# ── WhatsApp ───────────────────────────────────────────────────────────────
# simulado | meta. En simulado no sale ningun mensaje a la calle.
WA_PROVEEDOR=simulado
WA_WEBHOOK_VERIFY_TOKEN=
WA_APP_SECRET=
WA_PRECIO_MENSAJE_ARS=73
# true desde el 01/10/2026, cuando Meta empieza a cobrar los de servicio.
WA_COBRAR_SERVICIO=false

# ── Tus datos de cobro (los ve el negocio en "Mi suscripcion") ─────────────
COBRO_CBU=
COBRO_ALIAS=
COBRO_TITULAR=
COBRO_CUIT=
COBRO_BANCO=
COBRO_MP_LINK=
# Formato wa.me, sin el +.
COBRO_WHATSAPP=

# ── Precios ────────────────────────────────────────────────────────────────
# Si cambian, actualizar tambien frontend/src/lib/precios.ts (van en el bundle)
# y backend/app/core/planes.py, que es la grilla de verdad.
PRECIO_LISTA_MENSUAL=13900
PROMO_ACTIVA=false
PRECIO_PROMO_MENSUAL=11900
PROMO_ETIQUETA=Precio de lanzamiento

# ── Aviso de acceso al panel de super-admin ────────────────────────────────
# Vacio = no se manda nada.
ADMIN_ALERTA_EMAIL=
ADMIN_ALERTA_FALLIDOS=true
ADMIN_ALERTA_EN_DEV=false
ADMIN_ALERTA_GEOLOCALIZAR=true

# ── Cobro de la SUSCRIPCION por Mercado Pago (la cuenta de TURNOS360) ───────
# Vacio = apagado. Prender recien con dominio y HTTPS: sin IP publica los
# avisos de MP no llegan, y un cobro que nadie acredita es peor que no
# ofrecer el boton.
MP_SAAS_ACCESS_TOKEN=
MP_SAAS_WEBHOOK_SECRET=
#
# Webhook: https://TU-DOMINIO/api/publico/mp/webhook-suscripcion
# Tildar los TRES eventos, entran todos por esa misma URL:
#   payment · subscription_preapproval · subscription_authorized_payment
# Sin los dos ultimos el debito automatico cobra en MP pero el vencimiento
# del negocio no se mueve: el que paga aparece como moroso y nada falla.

# Plantilla del .env.prod. Copiar al servidor como .env.prod y completar.
# No se versiona (.gitignore excluye .env*).
#
# NO PONGAS COMENTARIOS EN LA MISMA LINEA QUE UNA VARIABLE.
# Si la variable queda VACIA, Docker Compose se toma el comentario COMO VALOR:
#   SECRET_KEY=        # firma de los JWT     ->   SECRET_KEY vale "# firma de los JWT"
# y el fail-fast no lo agarra porque no esta vacio. El backend levantaria en
# produccion firmando los JWT con una cadena publicada en este repositorio.
# Por eso todos los comentarios de este archivo van en su PROPIA linea.
#
# Generar secretos:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"

# ── Base de datos y Redis ──────────────────────────────────────────────────
POSTGRES_USER=turnos360
POSTGRES_PASSWORD=
POSTGRES_DB=turnos360
# solo alfanumérico: viaja dentro de una URL
REDIS_PASSWORD=

# ── Secretos ───────────────────────────────────────────────────────────────
# firma de los JWT
SECRET_KEY=
# cifra las credenciales guardadas. Distinta de SECRET_KEY.
# Rotarla deja ilegible lo guardado.
FERNET_KEY=

# ── Super-admin (primer seed) ──────────────────────────────────────────────
# NO uses admin@turnos360.com: ese, con la clave superadmin360, está escrito
# en seeds_minimo.py, que está en un repositorio público.
# La clave se valida en produccion (minimo 16, ni conocida ni adivinable):
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"
# Guardala en tu gestor de contrasenas Y dejala aca: si la perdes, se rota
# con  python -m app.seeds_minimo --rotar-clave
SUPERADMIN_EMAIL=
SUPERADMIN_PASS=

# ── URLs ───────────────────────────────────────────────────────────────────
# NEXT_PUBLIC_API_URL se hornea en el bundle: si cambia, rebuildear el front.
NEXT_PUBLIC_API_URL=
PUBLIC_BASE_URL=
API_BASE_URL=
# separados por coma
CORS_ORIGINS=

# ── Entorno ────────────────────────────────────────────────────────────────
# dev | staging | prod
ENV=prod
ZONA_HORARIA=America/Argentina/Buenos_Aires
UVICORN_WORKERS=2
# una línea de JSON por evento, para filtrar con jq
LOG_JSON=true
# opcional; vacío = te enterás por un cliente
SENTRY_DSN=

# ── Email saliente ─────────────────────────────────────────────────────────
SMTP_USER=
# contraseña de aplicación, sin espacios
SMTP_PASS=
SMTP_FROM=

# ── Mercado Pago: firma de los webhooks ────────────────────────────────────
# off | log | enforce. Camino: log unos días → mirar los logs → enforce.
MP_FIRMA_MODO=off
# MP → Tus integraciones → Webhooks → Clave secreta
MP_WEBHOOK_SECRET=

# ── WhatsApp ───────────────────────────────────────────────────────────────
# simulado | meta. En simulado no sale ningún mensaje a la calle.
WA_PROVEEDOR=simulado
WA_WEBHOOK_VERIFY_TOKEN=
WA_APP_SECRET=
# precio de venta de un mensaje
WA_PRECIO_MENSAJE_ARS=73
# true desde el 01/10/2026 (Meta empieza a cobrarlos)
WA_COBRAR_SERVICIO=false

# ── Tus datos de cobro (los ve el negocio en "Mi suscripción") ─────────────
COBRO_CBU=
COBRO_ALIAS=
COBRO_TITULAR=
COBRO_CUIT=
COBRO_BANCO=
COBRO_MP_LINK=
# formato wa.me, sin +
COBRO_WHATSAPP=

# ── Precios ────────────────────────────────────────────────────────────────
# Si cambian, actualizar también frontend/src/lib/precios.ts (van en el bundle).
PRECIO_LISTA_MENSUAL=13900
PROMO_ACTIVA=false
PRECIO_PROMO_MENSUAL=11900
PROMO_ETIQUETA=Precio de lanzamiento

# ── Aviso de acceso al panel de super-admin ────────────────────────────────
# vacío = no se manda nada
ADMIN_ALERTA_EMAIL=
ADMIN_ALERTA_FALLIDOS=true
ADMIN_ALERTA_EN_DEV=false
ADMIN_ALERTA_GEOLOCALIZAR=true

# ── Cobro de la SUSCRIPCIÓN por Mercado Pago (la cuenta de TURNOS360) ───────
# VACÍO = APAGADO, y así queda para el lanzamiento. Sin token, el botón "Pagar
# con Mercado Pago" no aparece y el webhook de cuotas no hace nada. Prendelo
# recién cuando tengas dominio con HTTPS: sin IP pública los avisos de MP no
# llegan, y un cobro que entra y nadie acredita es peor que no ofrecer el botón.
MP_SAAS_ACCESS_TOKEN=
# Clave secreta del webhook de ESA cuenta (MP → Tus integraciones → Webhooks).
# Distinta de MP_WEBHOOK_SECRET, que es la de las señas de los negocios.
MP_SAAS_WEBHOOK_SECRET=
#
# La URL del webhook: https://TU-DOMINIO/api/publico/mp/webhook-suscripcion
#
# QUÉ EVENTOS HAY QUE TILDAR EN MERCADO PAGO, que es la parte que se olvida:
#   · Pagos                                  (type: payment)
#   · Suscripciones                          (type: subscription_preapproval)
#   · Pagos recurrentes de una suscripción   (type: subscription_authorized_payment)
#
# Los dos últimos son los del DÉBITO AUTOMÁTICO. Sin ellos el token igual
# alcanza para cobrar, pero nunca nos enteramos: la tarjeta se cobra todos los
# meses en Mercado Pago y el vencimiento del negocio no se mueve. El cliente
# que paga religiosamente aparece como moroso, y no falla nada que se vea.
# Los tres entran por la MISMA URL; el backend los separa por el tipo
# (routers/publico.py::_TIPOS_DE_AVISO).
